default: all

include $(SPEC)
include MakeBase.gmk
include JarArchive.gmk
include JavaCompilation.gmk

################################################################################
# This makefile compiles and installs the hot code agent
#
################################################################################

HCA_SOURCE_DIR := $(TOPDIR)/src/utils/HotCodeAgent/src
HCA_OUTPUT_DIR := $(SUPPORT_OUTPUTDIR)/hca

$(eval $(call SetupJavaCompilation, BUILD_HCA, \
    TARGET_RELEASE := $(TARGET_RELEASE_NEWJDK_UPGRADED), \
    SRC := $(HCA_SOURCE_DIR), \
    BIN := $(SUPPORT_OUTPUTDIR)/hca_classes, \
))

$(eval $(call SetupJarArchive, BUILD_HCA_JAR, \
    DEPENDENCIES := $(BUILD_HCA), \
    SRCS := $(SUPPORT_OUTPUTDIR)/hca_classes, \
    JAR := $(SUPPORT_OUTPUTDIR)/modules_libs/java.base/hca.jar, \
    MANIFEST := $(HCA_SOURCE_DIR)/manifest.mf, \
))

################################################################################

all: $(BUILD_HCA_JAR)

.PHONY: all default
